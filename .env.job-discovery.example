# Job Discovery OS — do not commit real secrets
MONGODB_URI=
SESSION_SECRET=
JOB_DISCOVERY_STORE=mongo
CRON_SECRET=

# Request lifetime budgets (not data-count limits)
JOB_DISCOVERY_CRON_BUDGET_MS=45000
JOB_DISCOVERY_MANUAL_BUDGET_MS=45000

# Browser fallback is optional; start with API/structured-data adapters
JOB_DISCOVERY_BROWSER=0
JOB_DISCOVERY_ATLAS_SEARCH_INDEX=

# Optional supplemental sources
MUSE_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_HOST=jsearch.p.rapidapi.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
SMARTRECRUITERS_API_KEY=
