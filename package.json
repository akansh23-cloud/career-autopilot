{
  "name": "career-autopilot",
  "version": "4.0.0",
  "description": "AI job-application assistant — premium React frontend (Vite) served by the existing Express backend. Jobs are real & verified-only; AI returns structured resume JSON only. Same-origin deploy keeps Google OAuth + session cookies intact.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"node --watch server.js\" \"vite\"",
    "dev:api": "node --watch server.js",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node server.js",
    "preview": "npm run build && node server.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-session": "^1.18.0",
    "mammoth": "^1.8.0",
    "pdfjs-dist": "^4.7.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "framer-motion": "^11.15.0",
    "lucide-react": "^0.469.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.0.7"
  }
}
