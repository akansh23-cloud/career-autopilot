# ============================================================
# Career Autopilot — environment configuration
# Copy to .env (local) or set these as deployment env vars.
# NEVER commit a real .env. Secrets must not be committed.
# In PRODUCTION the server refuses to start unless the values
# marked [REQUIRED IN PROD] are set.
# ============================================================

# ---- Runtime ----
NODE_ENV=development          # set to "production" in prod
PORT=3000

# ---- Sessions / auth secrets ----
# [REQUIRED IN PROD] long random string (>= 32 chars). e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ---- Database (persistence) ----
# [REQUIRED IN PROD] MongoDB connection string. Without it in production the
# server will not start. In dev, leaving it blank runs in local/session-only mode.
MONGODB_URI=

# ---- Allowed browser origins (CORS) ----
# Only needed when the SPA is hosted on a DIFFERENT origin than this backend.
# For same-origin deploys (this server serves the SPA) leave blank.
FRONTEND_ORIGIN=https://your-app.example.com
# Optional extra comma-separated origins:
ALLOWED_ORIGINS=

# ---- Cross-site cookies ----
# Set to 1 ONLY when frontend and backend are on different domains over HTTPS.
COOKIE_CROSS_SITE=0
# COOKIE_SAMESITE=lax        # lax | none | strict  (auto: none when cross-site)
# COOKIE_SECURE=1            # auto-on in production

# ---- Content-Security-Policy ----
# Set to 1 to disable the strict CSP (only if a deployment needs extra origins).
DISABLE_CSP=0

# ---- AI (resume analysis, tailoring, template vision, project studio, grounded support) ----
ANTHROPIC_API_KEY=

# ---- Admin full-access allowlist ----
# Comma-separated emails that get full access without payment (role = admin).
# Resolved server-side from the authenticated session email; never sent to the frontend.
ADMIN_EMAILS=

# ---- Demo / dev login ----
# 1 = force-enable, 0 = force-disable. Default: auto-on only in non-prod without Google OAuth.
# Keep this OFF (or unset) for a public production launch.
ALLOW_DEV_LOGIN=

# ---- Google OAuth (sign in) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console EXACTLY, e.g. https://your-app.example.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Razorpay payments (plan upgrades) ----
# Without these the pricing modal shows a graceful "gateway not configured" message.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Job search providers (optional — expands coverage) ----
RAPIDAPI_KEY=                 # JSearch on RapidAPI
RAPIDAPI_HOST=jsearch.p.rapidapi.com
SERPAPI_KEY=                  # opportunities / job discovery fallback
# Tuning (ms):
JOB_FETCH_TIMEOUT=6000
JOB_VERIFY_TIMEOUT=5000
JOB_SEARCH_BUDGET=8000
JOB_CACHE_TTL_MS=90000
STRICT_JOB_VERIFICATION=0

# ---- Contact providers (verified emails) — optional ----
HUNTER_API_KEY=
APOLLO_API_KEY=
PDL_API_KEY=

# ---- LinkedIn / Indeed connectors (optional OAuth) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=

# ---- Rate limiting (optional overrides) ----
RATE_AI_PER_HOUR=60
RATE_JOBS_PER_HOUR=60
RATE_CONTACTS_PER_HOUR=40
RATE_TICKETS_PER_HOUR=5
RATE_GENERATION_PER_HOUR=80
RATE_GLOBAL_PER_MIN=300
RATE_GITHUB_PER_HOUR=60        # GitHub sync + repo analysis calls per user per hour

# ============================================================
# GitHub integration (Career Proof Profile) — all OPTIONAL.
# Two independent layers; configure either or both.
#   Layer 1 (OAuth identity): verify account ownership + sync public stats.
#                             MINIMAL scopes only (read:user user:email) — NO repo scope.
#   Layer 2 (GitHub App):     read-only access to USER-SELECTED repositories
#                             (public and/or private) for proof verification.
# Leaving these blank simply disables the feature; the manual GitHub URL still works.
# ============================================================

# ---- Layer 1: GitHub OAuth (identity only) ----
# Create at: https://github.com/settings/developers  (OAuth Apps)
#   Authorization callback URL must equal GITHUB_OAUTH_CALLBACK_URL below.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_OAUTH_CALLBACK_URL=http://localhost:3000/api/integrations/github/callback
GITHUB_OAUTH_SCOPES=read:user user:email   # do NOT add repo scopes here

# Encryption key for OAuth tokens stored at rest (AES-256-GCM).
# Any long random string. Falls back to SESSION_SECRET if unset (set this in prod).
OAUTH_TOKEN_ENCRYPTION_KEY=

# ---- Layer 2: GitHub App (selected-repository verification) ----
# Create at: https://github.com/settings/apps
#   Permissions (READ-ONLY): Repository contents: Read-only, Metadata: Read-only.
#     Optionally also Read-only: Actions, Commit statuses, Pull requests, Issues.
#     Do NOT grant write/admin/secrets/delete permissions.
#   Where can this app be installed: Any account.
#   Repository access: let users choose "Only select repositories".
#   Setup/Callback URL: GITHUB_APP_INSTALLATION_CALLBACK_URL below.
#   Webhook (optional but recommended): URL = <host>/api/integrations/github/webhook,
#     secret = GITHUB_APP_WEBHOOK_SECRET below. Subscribe to: Installation,
#     Installation repositories.
GITHUB_APP_ID=
GITHUB_APP_NAME=                # the app "slug" used in the install URL (github.com/apps/<slug>)
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the PEM private key. Multi-line is fine, or use \n escapes on one line.
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_WEBHOOK_SECRET=
GITHUB_APP_INSTALLATION_CALLBACK_URL=http://localhost:3000/api/integrations/github/app/callback

# Front-end origin used to build post-OAuth redirect URLs (defaults to request host).
# FRONTEND_ORIGIN=http://localhost:3000

# ============================================================
# INNOVATION & PATENT INTELLIGENCE OS
# ------------------------------------------------------------
# Source-backed problem discovery, project synthesis, IP-readiness
# triage. EVERYTHING degrades safely: with no keys it runs in a
# clearly-labelled "limited/fallback" mode (deterministic, low
# confidence). No key is required to boot the app.
# ============================================================

# Master switch. Set to 0 to hide all /api/problem-intelligence routes (they 404).
PROBLEM_INTELLIGENCE_ENABLED=1

# ---- Source connectors (all optional; raise rate limits when set) ----
# GitHub: a fine-grained or classic PAT with PUBLIC read only. NO repo scopes
# needed (issue search uses the public search API). Without it, GitHub issue
# search still works at lower unauthenticated rate limits.
GITHUB_TOKEN=
# Stack Exchange: optional app key for higher quota. Works keyless without it.
STACKEXCHANGE_KEY=
# arXiv needs no key. Manual problems need no key.

# ---- AI provider (optional; deterministic fallback used when absent) ----
# Which provider augments the deterministic engines: anthropic | openai | gemini | fallback
AI_PROVIDER=anthropic
# Anthropic (already used elsewhere in the app as ANTHROPIC_API_KEY).
# ANTHROPIC_API_KEY=                 # reuses the existing app key if already set
# OpenAI / OpenAI-compatible:
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Google Gemini:
GEMINI_API_KEY=
# Optional model override (else a sensible per-provider default is used).
AI_MODEL=

# ---- Tuning (safe defaults; override only if needed) ----
PROBLEM_DISCOVERY_MAX_SIGNALS=30
PROBLEM_DISCOVERY_TIMEOUT_MS=12000
PROBLEM_DISCOVERY_CACHE_TTL_MS=3600000
PROBLEM_DISCOVERY_MAX_RESPONSE_BYTES=2000000
