# ============================================================
# Career Autopilot — environment configuration
# Copy to .env (local) or set these as deployment env vars.
# NEVER commit a real .env. Secrets must not be committed.
# In PRODUCTION the server refuses to start unless the values
# marked [REQUIRED IN PROD] are set.
# ============================================================

# ---- Runtime ----
NODE_ENV=development          # set to "production" in prod
PORT=3000

# ---- Sessions / auth secrets ----
# [REQUIRED IN PROD] long random string (>= 32 chars). e.g. `openssl rand -hex 32`
SESSION_SECRET=

# ---- Database (persistence) ----
# [REQUIRED IN PROD] MongoDB connection string. Without it in production the
# server will not start. In dev, leaving it blank runs in local/session-only mode.
MONGODB_URI=

# ---- Allowed browser origins (CORS) ----
# Only needed when the SPA is hosted on a DIFFERENT origin than this backend.
# For same-origin deploys (this server serves the SPA) leave blank.
FRONTEND_ORIGIN=https://your-app.example.com
# Optional extra comma-separated origins:
ALLOWED_ORIGINS=

# ---- Cross-site cookies ----
# Set to 1 ONLY when frontend and backend are on different domains over HTTPS.
COOKIE_CROSS_SITE=0
# COOKIE_SAMESITE=lax        # lax | none | strict  (auto: none when cross-site)
# COOKIE_SECURE=1            # auto-on in production

# ---- Content-Security-Policy ----
# Set to 1 to disable the strict CSP (only if a deployment needs extra origins).
DISABLE_CSP=0

# ---- AI (resume analysis, tailoring, template vision, project studio, grounded support) ----
ANTHROPIC_API_KEY=

# ---- Admin full-access allowlist ----
# Comma-separated emails that get full access without payment (role = admin).
# Resolved server-side from the authenticated session email; never sent to the frontend.
ADMIN_EMAILS=

# ---- Demo / dev login ----
# 1 = force-enable, 0 = force-disable. Default: auto-on only in non-prod without Google OAuth.
# Keep this OFF (or unset) for a public production launch.
ALLOW_DEV_LOGIN=

# ---- Google OAuth (sign in) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match Google Cloud Console EXACTLY, e.g. https://your-app.example.com/auth/google/callback
GOOGLE_REDIRECT_URI=

# ---- Razorpay payments (plan upgrades) ----
# Without these the pricing modal shows a graceful "gateway not configured" message.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Job search providers (optional — expands coverage) ----
RAPIDAPI_KEY=                 # JSearch on RapidAPI
RAPIDAPI_HOST=jsearch.p.rapidapi.com
SERPAPI_KEY=                  # opportunities / job discovery fallback
# Tuning (ms):
JOB_FETCH_TIMEOUT=6000
JOB_VERIFY_TIMEOUT=5000
JOB_SEARCH_BUDGET=8000
JOB_CACHE_TTL_MS=90000
STRICT_JOB_VERIFICATION=0

# ---- Contact providers (verified emails) — optional ----
HUNTER_API_KEY=
APOLLO_API_KEY=
PDL_API_KEY=

# ---- LinkedIn / Indeed connectors (optional OAuth) ----
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
INDEED_CLIENT_ID=
INDEED_CLIENT_SECRET=

# ---- Rate limiting (optional overrides) ----
RATE_AI_PER_HOUR=60
RATE_JOBS_PER_HOUR=60
RATE_CONTACTS_PER_HOUR=40
RATE_TICKETS_PER_HOUR=5
RATE_GENERATION_PER_HOUR=80
RATE_GLOBAL_PER_MIN=300
