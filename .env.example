# ============================================================
#  Career Autopilot — environment
# ------------------------------------------------------------
#  Copy to `.env` and edit:   cp .env.example .env
#  `dotenv` loads it automatically on `npm start` / `npm run dev`.
#  Full reference: docs/ENVIRONMENT.md
# ============================================================

# ---- Required ------------------------------------------------
# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Express port. Leave at 3000 — the Vite dev proxy targets localhost:3000.
PORT=3000


# ---- Demo / recording ----------------------------------------
# Serves the in-memory 50-student demo cohort in the College Workspace.
# ONLY takes effect when MONGODB_URI is empty; with a real database
# connected this flag does nothing.
#
# DO NOT enable this on Vercel. The demo cohort's drives, outcomes and
# snapshots live in per-process memory, and each serverless invocation gets a
# fresh container — so a drive you create disappears on the next request.
# Demo mode is for a local machine or a single long-running server only.
DEMO_MODE=0

# Sign in without Google OAuth. Local only — on a public URL this lets
# anyone sign in as any address, including the admins below.
# Set to 1 only on localhost.
ALLOW_DEV_LOGIN=0

# Comma-separated. These addresses get admin (and therefore full
# College Workspace) access.
ADMIN_EMAILS=tpo@demo-institute.test


# ---- Persistence ---------------------------------------------
# Leave EMPTY for demo mode. Required in production — the app refuses
# to start with NODE_ENV=production and no MONGODB_URI.
MONGODB_URI=


# ---- AI providers (all optional) -----------------------------
# With none set, AI features degrade to deterministic fallbacks and
# say so rather than pretending to be AI-generated.
# AI_PROVIDER: openai | anthropic | gemini
AI_PROVIDER=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# Optional model override. LEAVE BLANK unless you have a specific reason —
# the server already defaults to a current model.
#
# Two traps worth knowing about:
#  1. resolveAiModel() accepts ONLY /^claude-[a-z0-9.-]+$/. A non-Claude id
#     (e.g. gemini-2.0-flash) is silently discarded and the Claude default is
#     used instead — it does not switch providers. Use AI_PROVIDER for that.
#  2. The pattern is shape-validation only; it is NOT checked against the
#     provider. A retired model id passes here and then returns 404 at request
#     time, surfacing in the app as "tailoring is temporarily unavailable".
AI_MODEL=


# ---- Google OAuth (optional locally) -------------------------
# Needed for real sign-in. With ALLOW_DEV_LOGIN=1 you don't need these.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=


# ---- Email (optional) ----------------------------------------
# Without these, college notifications are still created in-app and the
# delivery status is reported honestly as "not emailed".
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Public origin of the deployment, e.g. https://careerautopilot.co
# Used for cookie/CORS scoping and for links inside notification emails.
FRONTEND_ORIGIN=

# Shown on the legal pages; required for DPDP grievance-officer disclosure.
GRIEVANCE_EMAIL=

SUPPORT_EMAIL=


# ---- Payments (optional) -------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# GitHub proof verification (OPTIONAL but strongly recommended in production)
#
# Unauthenticated GitHub allows 60 requests/hour PER IP — that is the server's
# IP, shared by every student. Proof verification costs up to 5 calls per run,
# so anonymous access supports roughly a dozen verifications an hour across the
# whole platform before checks start returning 403.
#
# With a token the limit is 5,000/hour. Use a classic PAT with ONLY the
# `public_repo` scope (or a GitHub App installation token). Server-side only —
# never expose this to the browser.
#
# When unset, verification still works: checks that cannot run return `pending`
# with an honest note. No student is ever failed for a missing token.
GITHUB_TOKEN=
