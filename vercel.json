{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "framework": null,
  "functions": {
    "api/index.js": {
      "maxDuration": 30,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    {
      "source": "/(auth|ai|jobs|contacts|opportunities|profile|apply|health|support|dashboard)/:path*",
      "destination": "/api/index.js"
    },
    { "source": "/(auth|ai|jobs|contacts|opportunities|profile|apply|health|support|dashboard)", "destination": "/api/index.js" }
  ]
}
